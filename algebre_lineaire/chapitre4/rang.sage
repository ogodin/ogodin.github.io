A = matrix([[1, 2, 3], [2, 4, 6], [3, 6, 9]])
B = matrix([[-1, 8, 2, 9], [0, 2, 1, 8], [0, 4, 2, 16], [0, 0, 0, 5]])
C = matrix([[1, 2, 5, 0, 3], [0, 2, 2, 4, 6], [0, 0, -1, 2, 1], [0, 0, 3, -5, 0], [0, 0, 0, 0, 1]])
D = matrix([[1, 2, 3, 1], [1, 1, 2, 4]])

